      "reason": "macOS-internal daemon, agent or helper under /usr/libexec; Apple-only service with no Linux counterpart, BifrOSt springboard services cover whatever role applies",
      "path_prefix": "/usr/libexec/",
      "name_regex": "(d|agent|Agent|Helper|helper|Server|Service|Updater|Migrator)$"
    },
    {
      "reason": "macOS-internal daemon or manager under /usr/sbin; Apple-only service with no Linux counterpart, BifrOSt springboard services cover whatever role applies",
      "path_prefix": "/usr/sbin/",
      "name_regex": "(Agent|Helper|Manager|Server)$"
    },
    {
      "reason": "DTrace D script; DTrace is Apple/BSD only and BifrOSt traces with strace, perf and bpftrace",
      "path_prefix": "/usr/bin/",
      "name_regex": "\\.d$"
    }
  ]
