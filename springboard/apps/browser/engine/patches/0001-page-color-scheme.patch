+/// BifrOSt: the bits of `ColorSchemeFlags` (1 light, 2 dark, 4 only) for a meta `content` that is
+/// a valid CSS `color-scheme` value (`normal | [ light | dark | <custom-ident> ]+ && only?`), or
+/// `None` when it is not one. `normal` and values with unknown schemes only give 0.
+fn page_color_scheme_bits(content: &str) -> Option<u8> {
+    let (mut bits, mut schemes, mut normal) = (0u8, 0usize, 0usize);
+    for word in content.split_ascii_whitespace() {
+        let identifier = !word.starts_with(|c: char| c.is_ascii_digit()) &&
+            word.chars()
+                .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_' || !c.is_ascii());
+        if !identifier {
+            return None;
+        }
+        if word.eq_ignore_ascii_case("normal") {
+            normal += 1;
+        } else if word.eq_ignore_ascii_case("only") {
+            if bits & 4 != 0 {
+                return None;
+            }
+            bits |= 4;
+        } else {
+            schemes += 1;
+            if word.eq_ignore_ascii_case("light") {
+                bits |= 1;
+            } else if word.eq_ignore_ascii_case("dark") {
+                bits |= 2;
+            }
+        }
+    }
+    if normal != 0 {
+        return (normal == 1 && schemes == 0 && bits == 0).then_some(0);
+    }
+    (schemes != 0).then_some(bits)
+}
