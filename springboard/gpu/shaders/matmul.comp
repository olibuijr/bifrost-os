#version 450
// Row-major matrix product C = A * B: A is m x k, B is k x n, C is m x n, all float32 storage buffers. One invocation
// per output element. The CPU reference is ui::nn::matmul. Not wired to a pipeline yet; build.rs compiles it into the
// shader table like the other stages.

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BufB { float b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform Push {
    uint m;
    uint k;
    uint n;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    if (row >= pc.m || col >= pc.n) {
        return;
    }
    float sum = 0.0;
    for (uint p = 0u; p < pc.k; ++p) {
        sum += a[row * pc.k + p] * b[p * pc.n + col];
    }
    c[row * pc.n + col] = sum;
}
