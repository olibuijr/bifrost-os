#version 450
// Unsharp mask / clarity apply pass (GPU twin of render/src/kernel_photo_adjust.rs): the sharp image and a blurred
// copy (any of the Kawase passes will do) go in; the detail is added back, gated by a threshold and weighted by
// the midtones when `clarity` is set. Our own implementation of the textbook unsharp mask.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D sharp_tex;
layout(set = 0, binding = 1) uniform texture2D blur_tex;
layout(set = 0, binding = 2) uniform sampler smp;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D dst_img;

layout(push_constant) uniform Push {
    vec2 size;      // texels
    float amount;   // detail gain
    float threshold; // detail below this magnitude is left alone (unsharp mode)
    uint clarity;   // 0 = unsharp mask, 1 = midtone-weighted clarity
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.size.x) || p.y >= int(pc.size.y)) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / pc.size;
    vec4 s = texture(sampler2D(sharp_tex, smp), uv);
    vec3 b = texture(sampler2D(blur_tex, smp), uv).rgb;
    vec3 d = s.rgb - b;
    vec3 out_rgb;
    if (pc.clarity == 1u) {
        vec3 v = clamp(s.rgb, 0.0, 1.0);
        out_rgb = s.rgb + pc.amount * d * (4.0 * v * (1.0 - v));
    } else {
        vec3 gate = vec3(greaterThan(abs(d), vec3(pc.threshold)));
        out_rgb = s.rgb + pc.amount * d * gate;
    }
    imageStore(dst_img, p, vec4(clamp(out_rgb, 0.0, 1.0), s.a));
}
