#%PAM-1.0
# Used only by bifrost-privd (login.authenticate, auth.elevate, account.set_password). The account is always the installed user.
# There is no lockout module here on purpose: privd owns the lockout (privd/auth.rs, kept across reboots in
# /var/lib/springboard/privd-fails) and reports its wait to the login window. A second counter in this stack with its own
# times refused the correct password after the wait the login window had shown.
auth     required                    pam_unix.so
account  required                    pam_unix.so
