# The package owns /usr/share/springboard/system-assets. Older installs also hold unowned copies of the assets in
# /usr/share/springboard/assets (copied from the live medium by the installer); once system-assets has files, the helper
# removes the ones no package owns that the package now supersedes or that the allowlist does not name (vendor-derived
# icons among them). Idempotent; what it removes is logged to the package output and /var/log/bifrost-assets.log.
bifrost_prune_assets() {
    [ -x /usr/lib/springboard/prune-stale-assets ] || return 0
    out=$(/usr/lib/springboard/prune-stale-assets 2>&1) || true
    if [ -n "$out" ]; then
        echo "$out"
        { date -u +%FT%TZ; echo "$out"; } >> /var/log/bifrost-assets.log 2>/dev/null || true
    fi
    return 0
}

# bifrost-mcp (remote root exec for agents) runs only on a lab machine, which the lab installer marks with
# /etc/bifrost/lab-install. A machine the lab installer set up before the marker existed has /etc/ssh/sshd_config.d/05-lab.conf
# (written by no other path), so it gets the marker here and keeps its agent access. Everything else has the server stopped and
# disabled; a restart picks up a new binary on a lab machine.
bifrost_mcp_policy() {
    marker=/etc/bifrost/lab-install
    if [ ! -f "$marker" ] && [ -f /etc/ssh/sshd_config.d/05-lab.conf ]; then
        install -d -m755 /etc/bifrost 2>/dev/null && : > "$marker" 2>/dev/null || true
    fi
    if [ -f "$marker" ]; then
        if [ ! -f /etc/bifrost/mcp.env ] && [ -f /usr/share/bifrost/mcp-lab.env ]; then
            install -Dm644 /usr/share/bifrost/mcp-lab.env /etc/bifrost/mcp.env 2>/dev/null || true
        fi
        systemctl enable bifrost-mcp.service >/dev/null 2>&1 || true
        systemctl restart bifrost-mcp.service >/dev/null 2>&1 || true
    else
        systemctl disable --now bifrost-mcp.service >/dev/null 2>&1 || true
    fi
    return 0
}

bifrost_post_update() {
    bifrost_prune_assets
    install -d -m700 /var/lib/bifrost-recovery
    install -m755 /usr/bin/bifrost-update-guard /var/lib/bifrost-recovery/engine
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable bifrost-update-guard.service >/dev/null 2>&1 || true
    # per-machine modules, recorded after desktop-ready (docs/boot-architecture.md, "Prepared, not probed")
    systemctl enable bifrost-modules-record.service >/dev/null 2>&1 || true
    # login round: the socket group must exist before the units start; both units are fail-safe (docs/wayland-desktop.md)
    systemd-sysusers bifrost.conf >/dev/null 2>&1 || getent group bifrost-session >/dev/null || groupadd --system bifrost-session || true
    systemctl enable bifrost-privd.service >/dev/null 2>&1 || true
    systemctl start bifrost-update-guard.service >/dev/null 2>&1 || true
    systemctl enable --now power-profiles-daemon.service >/dev/null 2>&1 || true
    # agent access (docs/bifrost-mcp.md): lab machines only
    bifrost_mcp_policy
    # socket-activated services: started on the first desktop frame by bifrost-desktop-ready (docs/boot-architecture.md)
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable bifrost-desktop-ready.service bifrostd.service >/dev/null 2>&1 || true
    # a running supervisor reads the system services (/usr/lib/bifrost/services) it started with; restart it once so the
    # new binaries and manifests apply (the services start again on their next client, nothing waits on them)
    systemctl try-restart bifrostd.service >/dev/null 2>&1 || true
    # zram swap at boot (bifrostd adds disk swap files under memory pressure)
    systemctl enable bifrost-zram.service >/dev/null 2>&1 || true
    # application firewall policies (bifrost-firewall) loaded at boot
    systemctl enable bifrost-firewall.service >/dev/null 2>&1 || true
    # root helper: the group, the installed account's membership, then the daemon (docs/login-session.md)
    systemd-sysusers /usr/lib/sysusers.d/bifrost.conf >/dev/null 2>&1 || true
    # stage 1: the account is not added to bifrost-session (privd serves root only until the user-session stage)
    systemctl enable bifrost-privd.service >/dev/null 2>&1 || true
    systemctl restart bifrost-privd.service >/dev/null 2>&1 || true
    # audio server (docs/audio-architecture.md): its user and runtime directory, then the unit. The ALSA plug-in config
    # (/etc/alsa/conf.d/50-bifrost.conf) makes it the default PCM, so it must run whenever the package is installed.
    systemd-sysusers /usr/lib/sysusers.d/bifrost-audio.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/bifrost-audio.conf >/dev/null 2>&1 || true
    systemctl enable bifrost-audiod.service >/dev/null 2>&1 || true
    systemctl restart bifrost-audiod.service >/dev/null 2>&1 || true
    # printing (Settings > Print & Scan): cups is installed with the system, but nothing enabled it. The socket
    # activates cupsd on the first client, so it costs nothing while nothing prints
    if [ -f /usr/lib/systemd/system/cups.socket ]; then
        systemctl enable --now cups.socket >/dev/null 2>&1 || true
    fi
    # MIDI server: only when the package shipped it
    if [ -f /usr/lib/systemd/system/bifrost-midid.service ]; then
        systemctl enable bifrost-midid.service >/dev/null 2>&1 || true
        systemctl restart bifrost-midid.service >/dev/null 2>&1 || true
    fi
    bifrost_fontcache
}

# /etc/fonts/conf.d/61-bifrost-cjk-fallback.conf is a fontconfig scan rule: it applies only while a font directory is scanned,
# and fontconfig does not scan again a directory whose cache is valid. The Browser's fallback for CJK punctuation is the
# family the rule adds, so while that family is not listed the system cache is rebuilt once (-f); afterwards this does nothing.
bifrost_fontcache() {
    command -v fc-cache >/dev/null 2>&1 || return 0
    fc-list "Droid Sans Fallback" family 2>/dev/null | grep -q . || fc-cache -sf >/dev/null 2>&1 || true
    return 0
}

# Screen Sharing sign-in rules (one allowed account, lockout) replace the wayvnc package default PAM service.
bifrost_pam_wayvnc() {
    [ -f /usr/share/bifrost/pam/wayvnc ] && install -m644 /usr/share/bifrost/pam/wayvnc /etc/pam.d/wayvnc
    return 0
}

# The public key that signs this repository (packaging/arch/keys): imported into pacman's keyring and signed locally, so a
# signed repository is trusted under SigLevel TrustedOnly. Idempotent; a missing key or keyring is not an error.
bifrost_repo_key() {
    key=/usr/share/bifrost/keys/bifrost-repo.gpg
    [ -f "$key" ] || return 0
    command -v pacman-key >/dev/null 2>&1 || return 0
    pacman-key --add "$key" >/dev/null 2>&1 || return 0
    fpr=$(gpg --batch --with-colons --import-options show-only --import "$key" 2>/dev/null | awk -F: '$1=="fpr"{print $10; exit}')
    [ -n "$fpr" ] && pacman-key --lsign-key "$fpr" >/dev/null 2>&1
    return 0
}

post_install() {
    bifrost_repo_key
    bifrost_pam_wayvnc
    bifrost_post_update
    echo "BifrOSt: run 'systemctl enable springboard.service && systemctl set-default graphical.target'"
}

post_upgrade() {
    bifrost_repo_key
    bifrost_pam_wayvnc
    bifrost_post_update
    echo "BifrOSt: apply the update through Settings > Software Update."
}

pre_remove() {
    systemctl disable --now springboard.service >/dev/null 2>&1 || true
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    echo "springboard-shell: /var/lib/springboard (user data) was kept."
}
