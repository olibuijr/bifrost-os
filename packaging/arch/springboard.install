bifrost_post_update() {
    install -d -m700 /var/lib/bifrost-recovery
    install -m755 /usr/bin/bifrost-update-guard /var/lib/bifrost-recovery/engine
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable bifrost-update-guard.service >/dev/null 2>&1 || true
    # per-machine modules, recorded after desktop-ready (docs/boot-architecture.md, "Prepared, not probed")
    systemctl enable bifrost-modules-record.service >/dev/null 2>&1 || true
    # login round: the socket group must exist before the units start; both units are fail-safe (docs/wayland-desktop.md)
    systemd-sysusers bifrost.conf >/dev/null 2>&1 || getent group bifrost-session >/dev/null || groupadd --system bifrost-session || true
    systemctl enable bifrost-privd.service >/dev/null 2>&1 || true
    systemctl start bifrost-update-guard.service >/dev/null 2>&1 || true
    systemctl enable --now power-profiles-daemon.service >/dev/null 2>&1 || true
    # agent access (docs/bifrost-mcp.md), on by default; restart picks up the new binary
    systemctl enable bifrost-mcp.service >/dev/null 2>&1 || true
    systemctl restart bifrost-mcp.service >/dev/null 2>&1 || true
    # socket-activated services: started on the first desktop frame by bifrost-desktop-ready (docs/boot-architecture.md)
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable bifrost-desktop-ready.service bifrostd.service >/dev/null 2>&1 || true
    # zram swap at boot (bifrostd adds disk swap files under memory pressure)
    systemctl enable bifrost-zram.service >/dev/null 2>&1 || true
    # root helper: the group, the installed account's membership, then the daemon (docs/login-session.md)
    systemd-sysusers /usr/lib/sysusers.d/bifrost.conf >/dev/null 2>&1 || true
    # stage 1: the account is not added to bifrost-session (privd serves root only until the user-session stage)
    systemctl enable bifrost-privd.service >/dev/null 2>&1 || true
    systemctl restart bifrost-privd.service >/dev/null 2>&1 || true
    # audio server (docs/audio-architecture.md): its user and runtime directory, then the unit. The ALSA plug-in config
    # (/etc/alsa/conf.d/50-bifrost.conf) makes it the default PCM, so it must run whenever the package is installed.
    systemd-sysusers /usr/lib/sysusers.d/bifrost-audio.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/bifrost-audio.conf >/dev/null 2>&1 || true
    systemctl enable bifrost-audiod.service >/dev/null 2>&1 || true
    systemctl restart bifrost-audiod.service >/dev/null 2>&1 || true
}

post_install() {
    bifrost_post_update
    echo "BifrOSt: run 'systemctl enable springboard.service && systemctl set-default graphical.target'"
}

post_upgrade() {
    bifrost_post_update
    echo "BifrOSt: apply the update through Settings > Software Update."
}

pre_remove() {
    systemctl disable --now springboard.service >/dev/null 2>&1 || true
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    echo "springboard-shell: /var/lib/springboard (user data) was kept."
}
