# Maintainer: Olafur Bui Olafsson <olibuijr@olibuijr.com>
# Local package, never published. Builds from this repo checkout; see README.md.
pkgname=springboard-shell
pkgver=0.3.15
pkgrel=1
pkgdesc='BifrOSt macOS-style desktop shell for x86_64 PCs'
arch=(x86_64)
url='https://bifrost.olibuijr.com'
license=(custom)
mapfile -t depends < "${PC_PKGSRC:-$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")}/runtime-packages.txt"
makedepends=(cargo python)
options=(!lto !strip)
install=springboard.install
source=(springboard.service seed-data bifrost-privd.service pam-bifrost-login sysusers-bifrost.conf sysctl-bifrost.conf)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP)

# Inputs (override from the environment):
#   SPRINGBOARD_REPO    bifrost-os checkout        (default: two levels above this PKGBUILD)
#   SPRINGBOARD_DEPS    parent dir of the sibling repos iOSTerm, ipad-deildu-rust
#                       (default: the checkout parent, where sibling repositories live)
#   SPRINGBOARD_ASSETS  packed assets dir          (default: <repo>/springboard/assets, from tools/pack.py)
_here=$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")
_repo=${SPRINGBOARD_REPO:-$(cd "$_here/../.." && pwd)}
_deps=${SPRINGBOARD_DEPS:-$(dirname "$_repo")}
_assets=${SPRINGBOARD_ASSETS:-$_repo/springboard/assets}

pkgver() {
  grep -m1 '^version' "$_repo/springboard/Cargo.toml" | sed 's/.*"\(.*\)".*/\1/'
}

prepare() {
  # Self-contained build tree: the checkout plus copies of the path-dependency repos, with the
  # sibling dependency paths in Cargo.toml rewritten to the copies. Sources only, no target dirs.
  rm -rf "$srcdir/tree"
  mkdir -p "$srcdir/tree/deps"
  tar -C "$_repo" --exclude=target --exclude=assets -cf - springboard packaging | tar -C "$srcdir/tree" -xf -
  for d in iOSTerm ipad-deildu-rust; do
    [ -d "$_deps/$d" ] || { echo "missing sibling repo $_deps/$d (set SPRINGBOARD_DEPS)" >&2; return 1; }
    tar -C "$_deps" --exclude=target --exclude=.git -cf - "$d" | tar -C "$srcdir/tree/deps" -xf -
  done
  sed -i 's#path = "../../#path = "../deps/#g' "$srcdir/tree/springboard/Cargo.toml"
}

build() {
  cd "$srcdir/tree/springboard"
  export CARGO_TARGET_DIR="$srcdir/target"
  # Crates come from the local cargo registry cache (CARGO_HOME); nothing is fetched when it is warm.
  rustc --edition 2021 -O -C target-feature=+crt-static -C strip=symbols "$_repo/packaging/arch/recovery/guard.rs" -o "$srcdir/bifrost-update-guard"
  # the EFI loader is built from source, never taken from the committed binary (fails the package if it cannot build)
  "$_repo/tools/build-efi-boot.sh" release || exit 1
  cargo build --release --locked --features desktop-wayland --bin shell --bin bootweave --bin bifrost-portal --bin bifrost-privd ${SPRINGBOARD_CARGO_FLAGS:---offline}
  cargo build --release --locked -p bifrost-mcp ${SPRINGBOARD_CARGO_FLAGS:---offline}
  cargo build --release --locked -p bifrostd ${SPRINGBOARD_CARGO_FLAGS:---offline}
  # the system services bifrostd supervises (shipped under /usr/lib/bifrost/services by package-files.sh)
  cargo build --release --locked -p audiod -p netd -p updated ${SPRINGBOARD_CARGO_FLAGS:---offline}
  cargo build --release --locked -p bifrost-audiod -p bifrost-audio-bench -p bifrost-midid -p bifrost-alsa-plugin ${SPRINGBOARD_CARGO_FLAGS:---offline}
  cargo build --release --locked -p bifrost-app --bin bifrost-log ${SPRINGBOARD_CARGO_FLAGS:---offline}
  # the new stack (docs/graphics-architecture.md): the window server and the chrome clients; shaders are compiled in
  cargo build --release --locked -p bifrost-wm --bin bifrost-wm ${SPRINGBOARD_CARGO_FLAGS:---offline}
  cargo build --release --locked -p bifrost-chrome --bins ${SPRINGBOARD_CARGO_FLAGS:---offline}
  # the command-line tools (springboard/cmd/src/bin): package-files.sh installs every one of them
  cargo build --release --locked -p bifrost-cmd --bins ${SPRINGBOARD_CARGO_FLAGS:---offline}
  # the system English dictionary (WordNet 3.0 as StarDict; pinned in packaging/arch/dictionaries/wordnet.json). The
  # tarball and the built files are cached in the repo's out/ (upstream/, dictionaries/wordnet/) and rebuilt only when
  # the pin or the converter changes; a download that is needed and fails stops the build.
  python3 "$_repo/tools/build-wordnet-stardict.py" "$srcdir/dictionaries" || { echo "PKGBUILD: the WordNet dictionary could not be built" >&2; return 1; }
}

check() {
  [ -x "$srcdir/target/release/shell" ]
}

package() {
  source "$_repo/packaging/arch/package-files.sh"
  PC_MCP="$srcdir/target/release/bifrost-mcp" PC_BIFROSTD="$srcdir/target/release/bifrostd" PC_AUDIOD="$srcdir/target/release/bifrost-audiod" PC_SVC_AUDIOD="$srcdir/target/release/audiod" PC_SVC_NETD="$srcdir/target/release/netd" PC_SVC_UPDATED="$srcdir/target/release/updated" PC_AUDIO_BENCH="$srcdir/target/release/bifrost-audio-bench" PC_MIDID="$srcdir/target/release/bifrost-midid" PC_ALSA_PLUGIN="$srcdir/target/release/libasound_module_pcm_bifrost.so" PC_CMD_DIR="$srcdir/target/release" PC_DICTIONARIES="$srcdir/dictionaries" package_bifrost_files "$_repo/packaging/arch" "$srcdir/target/release/shell" "$srcdir/bifrost-update-guard"
  install -Dm755 "$srcdir/target/release/bootweave" "$pkgdir/usr/bin/bifrost-bootweave"
  install -Dm755 "$srcdir/target/release/bifrost-portal" "$pkgdir/usr/bin/bifrost-portal"
  install -Dm755 "$srcdir/target/release/bifrost-privd" "$pkgdir/usr/bin/bifrost-privd"
  install -Dm755 "$srcdir/target/release/bifrost-mcp" "$pkgdir/usr/bin/bifrost-mcp"
  install -Dm755 "$srcdir/target/release/bifrostd" "$pkgdir/usr/bin/bifrostd"
  install -Dm755 "$srcdir/target/release/bifrost-log" "$pkgdir/usr/bin/bifrost-log"
  install -Dm755 "$srcdir/target/release/bifrost-wm" "$pkgdir/usr/bin/bifrost-wm"
  for chrome in bifrost-menubar bifrost-dock bifrost-panels; do
    install -Dm755 "$srcdir/target/release/$chrome" "$pkgdir/usr/bin/$chrome"
  done
  install -d "$pkgdir/usr/share/springboard"
  if [ -d "$_assets" ]; then
    # the package-owned system assets (like the published package): only what packaging/assets-allowlist.txt names, so a
    # stray file in the assets dir (a font or icon BifrOSt has no right to redistribute) is skipped, never copied whole
    python3 "$_repo/tools/stage-assets.py" "$_assets" "$pkgdir/usr/share/springboard/system-assets" || return 1
  else
    install -d "$pkgdir/usr/share/springboard/system-assets"
  fi
  # licence guard: refuse a package with reference assets or a font that names no open licence
  python3 "$_repo/tools/check-package-licenses.py" "$pkgdir" || return 1
}
