[Unit]
Description=BifrOSt privileged helper (login, updates, store installs, power, time)
Documentation=file:///usr/share/doc/bifrost/login-session.md
# Early like springboard.service, but NOT ordered after the UI: if privd is dead the shell shows
# "Login service unavailable" and the recovery chord and ssh still work.
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service systemd-sysusers.service
Before=springboard.service shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/var/lib/springboard

[Service]
Type=simple
ExecStart=/usr/bin/bifrost-privd
Restart=always
RestartSec=1
# Shutdown budget (docs/boot-architecture.md, "Symmetric shutdown"): a stop that is not done in 2 s is killed.
TimeoutStopSec=2s
# /home is read-only for this daemon except where user.add / user.delete create and remove home directories.
ProtectHome=read-only
ReadWritePaths=/home
# NoNewPrivileges is deliberately not set: privd runs chpasswd and pacman as root.
RuntimeDirectory=bifrost
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
