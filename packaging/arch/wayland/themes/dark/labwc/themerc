# BifrOSt labwc theme, dark variant. The shell copies the matching variant into
# ~/.local/share/themes/BifrOSt/labwc/ when the system appearance changes.
border.width: 1
padding.width: 0
padding.height: 0
window.titlebar.padding.width: 10
window.titlebar.padding.height: 8
window.button.width: 20
window.button.height: 20
window.button.spacing: 4
window.label.text.justify: center
window.active.border.color: #1A1A1A
window.inactive.border.color: #1A1A1A
window.active.title.bg.color: #2D2D2D
window.inactive.title.bg.color: #262626
window.active.label.text.color: #E5E5E5
window.inactive.label.text.color: #8C8C8C
window.active.button.unpressed.image.color: #E5E5E5
window.inactive.button.unpressed.image.color: #8C8C8C
menu.items.bg.color: #2D2D2D
menu.items.text.color: #E5E5E5
menu.items.active.bg.color: #0A60FF
menu.items.active.text.color: #FFFFFF
