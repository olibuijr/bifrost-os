#!/bin/bash
# The compositor and Linux apps run as the installed account. The existing shell
# keeps its system-service privileges until those services have separate helpers.
set -euo pipefail
mark() {
    /usr/bin/bifrost-bootweave mark "$1" 2>/dev/null || true
}
mark session-start
account=$(sed -n 's/^username=//p' /var/lib/springboard/account)
client=/usr/bin/springboard
[[ "$account" =~ ^[a-z_][a-z0-9_-]*$ ]] || { echo 'No valid BifrOSt local account' >&2; exit 1; }
# Values come from the validated installer layout catalogue, never source/eval.
if [[ -f /etc/bifrost/keyboard.env ]]; then
    while IFS='=' read -r key value; do
        if [[ "$key" == XKB_DEFAULT_LAYOUT || "$key" == XKB_DEFAULT_VARIANT ]] && [[ "$value" =~ ^[a-zA-Z0-9_,+-]*$ ]]; then export "$key=$value"; fi
    done < /etc/bifrost/keyboard.env
fi
uid=$(id -u "$account")
# The session's processes run as the account without a PAM session: runuser's pam_systemd started the account's
# systemd user manager synchronously before the compositor could launch (~0.6 s of every boot on the lab PC, round
# 75). The runtime directory and the seat (seatd) are set up here, so nothing in the session needs that login.
as_user() {
    setpriv --reuid="$uid" --regid="$(id -g "$account")" --init-groups \
        env HOME="$(getent passwd "$account" | cut -d: -f6)" USER="$account" LOGNAME="$account" "$@"
}
runtime=/run/bifrost/user
install -d -m700 -o "$uid" -g "$(id -g "$account")" "$runtime"
# A dedicated session runtime is safe to clean after systemd stops the old
# cgroup. A stale socket must not satisfy the compositor readiness check.
rm -f "$runtime"/wayland-* "$runtime"/session.json "$runtime"/shell-ready "$runtime"/bus
usermod -aG seat,video,render,input "$account"
systemctl start seatd.service
cleanup() {
    trap - EXIT TERM INT
    [[ -n ${shell_pid:-} ]] && kill "$shell_pid" 2>/dev/null || true
    [[ -n ${compositor_pid:-} ]] && kill "$compositor_pid" 2>/dev/null || true
    [[ -n ${bus_pid:-} ]] && kill "$bus_pid" 2>/dev/null || true
    wait 2>/dev/null || true
}
# A stop requested by systemd (reboot, shutdown, restart) is deliberate, not a crash: do not let it count toward the
# shell's crash-loop latch. Only starts that die on their own are counted.
stopped() { rm -f /var/lib/springboard/boot_attempts; exit 0; }
trap cleanup EXIT
trap stopped TERM INT
# Session bus at a fixed path so apps (and the sandbox) can reach it; activates bifrost-portal (Settings portal).
if command -v dbus-daemon >/dev/null; then
    as_user dbus-daemon --session --nofork --nopidfile --address="unix:path=$runtime/bus" 1>&2 &
    bus_pid=$!
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus"
    # the launchers' environment update (session-env) needs the socket: wait for it, at most 2 s
    for ((i=0;i<100;i++)); do
        [[ -S "$runtime/bus" ]] && break
        kill -0 "$bus_pid" 2>/dev/null || break
        sleep .02
    done
fi
mark compositor-start
# The window server is BifrOSt's own (docs/window-server.md). After three quick exits it restarts in safe mode
# (no direct apps, default renderer, no chrome clients) until the next boot; safe mode failing too ends the session.
source /usr/lib/bifrost/session-policy
[[ -x /usr/bin/bifrost-wm ]] || { echo 'bifrost-wm is not installed' >&2; exit 1; }
mode=normal; [[ -e /run/bifrost/compositor-fallback ]] && mode=safe
# The switches (docs/graphics-architecture.md): renderer and chrome, read as plain words.
renderer=$(session_switch /etc/bifrost/renderer 'a-z')
chrome=$(session_switch /etc/bifrost/chrome '0-9')
[[ "$mode" == safe ]] && chrome=
wm_flags=()
while IFS= read -r word; do [[ -n "$word" ]] && wm_flags+=("$word"); done < <(session_compositor_flags "$renderer" "$chrome" "$mode")
# the first desktop of this boot fades in from the loader's frame; a session restart does not
fade=; grep -q ' desktop-faded$' /run/bifrost/boot-marks 2>/dev/null || fade=1
# bifrost-wm owns the screen, so it shows the loader's frame and does the boot fade, not the shell
as_user env XDG_RUNTIME_DIR="$runtime" LIBSEAT_BACKEND=seatd MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=131072 MALLOC_TOP_PAD_=65536 ${fade:+BIFROST_BOOT_FADE=1} \
    ${wm_flags[@]+"${wm_flags[@]}"} /usr/bin/bifrost-wm --drm --socket wayland-0 1>&2 &
compositor_pid=$!
for ((i=0;i<250;i++)); do
    [[ -S "$runtime/wayland-0" ]] && break
    kill -0 "$compositor_pid" 2>/dev/null || exit 1
    sleep .02
done
# the launchers' environment, the display mode refresh and the Settings portal
as_user env XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY=wayland-0 /usr/lib/bifrost/session-env 1>&2 &
as_user env XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY=wayland-0 /usr/lib/bifrost/display-refresh 1>&2 &
as_user env XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY=wayland-0 ${DBUS_SESSION_BUS_ADDRESS:+DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS} /usr/bin/bifrost-portal 1>&2 &
for ((i=0;i<250;i++)); do
    [[ -S "$runtime/wayland-0" && -f "$runtime/session.json" ]] && break
    kill -0 "$compositor_pid" 2>/dev/null || exit 1
    sleep .02
done
[[ -S "$runtime/wayland-0" && -f "$runtime/session.json" ]] || { echo 'Wayland startup timed out' >&2; exit 1; }
mark compositor-ready
# The shell's crash-loop guard latches after three starts that never stay up for 60 s. A new shell build must
# not inherit that latch: reset it whenever the installed springboard-shell version changes.
# (the pacman database directory names the version; `pacman -Q` costs ~100 ms on the boot path)
# a new shell binary resets the crash-loop counter: keyed on the binary itself (inode and mtime, one stat); the glob
# over pacman's database it replaced took 0.65 s on a cold boot, right before the shell launch (round 75)
shell_version=$(stat -c '%i:%Y' "$client" 2>/dev/null)
stamp=/var/lib/springboard/shell-version
if [[ -n "$shell_version" && "$(cat "$stamp" 2>/dev/null || true)" != "$shell_version" ]]; then
    rm -f /var/lib/springboard/boot_attempts
    printf '%s\n' "$shell_version" > "$stamp"
fi
mark shell-launch
launch_shell() {
    env XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY=wayland-0 SPRINGBOARD_WAYLAND=1 \
        ${wm_flags[@]+"${wm_flags[@]}"} "$client" &
    shell_pid=$!
}
launch_shell
# With the chrome switch the menu bar, Dock and panels run as their own clients beside the shell (docs/graphics-architecture.md).
if [[ "$chrome" == 1 ]]; then
    for chrome_client in bifrost-menubar bifrost-dock bifrost-panels; do
        [[ -x /usr/bin/$chrome_client ]] || continue
        as_user env XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY=wayland-0 "${wm_flags[@]}" "/usr/bin/$chrome_client" 1>&2 &
    done
fi
# learns the display mode for the next boot's command line; off the critical path
/usr/lib/bifrost/video-arg >&2 &
set +e
# The window server outlives the shell: outputs, the lock and app windows stay while only the shell restarts
# (no-restart updates). The shell's own crash-loop latch still applies; three quick exits end the session.
quick=0
while :; do
    started=$SECONDS
    wait -n "$shell_pid" "$compositor_pid"
    status=$?
    if ! kill -0 "$compositor_pid" 2>/dev/null; then
        # bifrost-wm died on its own: three such exits within 60 s make the next session start use safe mode;
        # three more in safe mode end in exit 1 and the recovery (bifrost-update-guard) takes over
        if [[ "$mode" == safe ]]; then
            if [[ "$(wm_exit_action "$(date +%s)" /run/bifrost/wm-safe-exits)" == fallback ]]; then
                echo 'bifrost-wm exited three times within 60 s in safe mode: giving up' >&2
                status=1
            fi
        elif [[ "$(wm_exit_action "$(date +%s)" /run/bifrost/wm-exits)" == fallback ]]; then
            : > /run/bifrost/compositor-fallback
            echo 'bifrost-wm exited three times within 60 s: restarting in safe mode' >&2
            status=1
        fi
        break
    fi
    [[ "$status" == 3 ]] && break                      # Software Update restarts the whole session
    if (( SECONDS - started < 60 )); then quick=$((quick + 1)); else quick=0; fi
    (( quick >= 3 )) && break
    mark shell-relaunch
    launch_shell
done
shell_exit_note "$status" >&2
# Software Update deliberately exits 3 to restart. Preserve that as failure
# because the existing service uses Restart=on-failure.
if [[ "$status" == 3 && -f /var/lib/bifrost-recovery/state ]] && grep -qx system-prepared /var/lib/bifrost-recovery/state; then
    /usr/bin/bifrost-update-guard apply
fi
exit "$status"
