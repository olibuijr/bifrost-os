[Unit]
Description=BifrOSt native installer
# Early start: the installer owns DRM/KMS as root; it does not wait for basic.target, seatd or logins.
# sysinit.target stays: taking over tty1 before it left the console-bound early units hanging (no sshd on the
# lab ISO); waiting for it costs ~0.1 s (tools/boot-bench.py).
DefaultDependencies=no
After=sysinit.target systemd-udevd.service systemd-udev-trigger.service
Conflicts=getty@tty1.service springboard.service shutdown.target
Before=shutdown.target
ConditionKernelCommandLine=!bifrost.live=1

[Service]
Environment=BIFROST_ASSETS=/usr/share/springboard/assets
# lab builds (token present): let the installer publish screenshots and accept injected input
ExecStartPre=-/bin/sh -c '[ -e /etc/bifrost/lab.token ] && touch /run/bifrost-shot-on || true'
# The EFI frame remains in simpledrm until the native installer opens KMS.
# The installer owns DRM/KMS directly. The installed desktop uses the Wayland
# session, but starting the installer through the compositor makes it hold
# the card and leaves the installer with no display.
ExecStart=/usr/bin/bifrost-installer
Restart=on-failure
RestartSec=1
StandardInput=tty-force
TTYPath=/dev/tty1
# no TTYReset/TTYVHangup: both make the kernel console clear tty1, which paints the loader's frame black
TTYReset=no
TTYVHangup=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
